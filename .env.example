# ==========================================
# PlaceMate Environment Configuration
# ==========================================
# Copy this file to .env.local for local execution
# NEVER commit sensitive production credentials to Git!

# PostgreSQL Database (Neon Serverless Postgres / Supabase / Local Postgres)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/placemate?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="placemate_super_secure_jwt_secret_change_in_production_key_32chars"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telemetry: Grafana Cloud OpenTelemetry (OTLP) Ingestion (Optional)
GRAFANA_OTLP_ENDPOINT="https://otlp-gateway-prod-us-central-0.grafana.net/otlp/v1/metrics"
GRAFANA_OTLP_USER_ID="your_grafana_instance_id"
GRAFANA_OTLP_API_KEY="glc_your_grafana_cloud_api_token"
GRAFANA_DASHBOARD_URL="https://your-org.grafana.net/d/placemate/placemate-monitoring"

# Vercel Runtime Variables (Provided automatically by Vercel in production)
VERCEL_ENV="development"
VERCEL_REGION="dev1"
